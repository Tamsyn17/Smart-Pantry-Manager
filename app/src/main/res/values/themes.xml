<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SmartPantryManager"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Main app colours -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorPrimaryContainer">@color/purple_light</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSecondary">@color/purple_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- App background -->
        <item name="android:windowBackground">@color/background_main</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:navigationBarColor">@color/background_main</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Material surface -->
        <item name="colorSurface">@color/surface_card</item>

    </style>

    <style name="Theme.SmartPantryManager"
        parent="Base.Theme.SmartPantryManager" />

</resources>