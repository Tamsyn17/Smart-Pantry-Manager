<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen kitchen background -->
    <ImageView
        android:id="@+id/imgWelcomeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/welcome_kitchen_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Kitchen pantry background" />

    <!-- Soft white overlay so text remains readable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF" />

    <!-- Welcome screen content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="60dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart ♡"
            android:textColor="@color/purple_primary_dark"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:text="P A N T R Y   M A N A G E R"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Good food starts\nwith what you have"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <!-- Feature row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♡&#10;Track&#10;ingredients"
                android:textColor="@color/purple_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♻&#10;Reduce&#10;waste"
                android:textColor="@color/purple_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="✦&#10;Discover&#10;recipes"
                android:textColor="@color/purple_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Push button towards bottom -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnEnterPantry"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/purple_primary"
            android:text="Enter My Pantry  →"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="A  S M A R T E R   W A Y   T O   A&#10;H A P P I E R   K I T C H E N"
            android:textColor="@color/purple_primary_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="♡"
            android:textColor="@color/purple_primary"
            android:textSize="22sp" />

    </LinearLayout>

</FrameLayout>